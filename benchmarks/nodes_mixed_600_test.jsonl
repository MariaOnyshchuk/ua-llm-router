{"id": "nx-knowledge-018", "split": "test", "bucket": "knowledge", "skill": "knowledge", "label": "knowledge", "subtype": "commonsense selection", "form": "root", "prompt": "Для прибирання у ванній знадобиться що з цього: губка, засіб для чищення, гумові рукавички, книжка, шоколад? Відповідь — потрібне через кому.", "does": "", "gold": "губка, засіб для чищення, гумові рукавички", "wrong": "губка, книжка", "check": {"type": "all", "rubrics": [{"type": "contains_all", "values": ["губк", "засіб", "рукавич"]}, {"type": "not_contains", "values": ["книж", "шоколад"]}]}}
