{"id": "nx-translate-005", "split": "test", "bucket": "translate", "skill": "translate", "label": "translate", "subtype": "Ukrainian → English sentence", "form": "root", "prompt": "Речення «Брат виграв шаховий турнір у своїй школі» запиши англійською.", "does": "", "gold": "My brother won the chess tournament at his school.", "wrong": "My brother plays football.", "check": {"type": "all", "rubrics": [{"type": "contains_any", "values": ["brother"]}, {"type": "contains_any", "values": ["won", "win"]}, {"type": "contains_any", "values": ["chess"]}, {"type": "contains_any", "values": ["tournament", "competition"]}]}}
{"id": "nx-translate-006", "split": "test", "bucket": "translate", "skill": "translate", "label": "translate", "subtype": "Ukrainian → English sentence", "form": "root", "prompt": "Будь ласка, переклади на англійську: Електричка до Ірпеня відправляється з п'ятої колії.", "does": "", "gold": "The commuter train to Irpin departs from track five.", "wrong": "The bus is late.", "check": {"type": "all", "rubrics": [{"type": "contains_any", "values": ["train"]}, {"type": "contains_any", "values": ["irpin"]}, {"type": "contains_any", "values": ["five", "5", "fifth"]}, {"type": "contains_any", "values": ["track", "platform"]}]}}
{"id": "nx-translate-007", "split": "test", "bucket": "translate", "skill": "translate", "label": "translate", "subtype": "Ukrainian → English sentence", "form": "root", "prompt": "Я загубив рукавичку десь у парку. — як це буде англійською?", "does": "", "gold": "I lost a glove somewhere in the park.", "wrong": "I found a hat.", "check": {"type": "all", "rubrics": [{"type": "contains_any", "values": ["lost"]}, {"type": "contains_any", "values": ["glove"]}, {"type": "contains_any", "values": ["park"]}]}}
