{"id": "nx-knowledge-001", "split": "test", "bucket": "knowledge", "skill": "knowledge", "label": "knowledge", "subtype": "search in a given timetable, notice or log", "form": "root", "prompt": "Розклад бібліотеки: вівторок — п'ятниця 10:00–19:00, субота 10:00–15:00, неділя і понеділок — вихідні. Я хочу повернути книжку в понеділок о 12:00. Чи вийде?", "does": "", "gold": "Ні, у понеділок бібліотека не працює.", "wrong": "Так, бібліотека працює з 10:00.", "check": {"type": "all", "rubrics": [{"type": "regex", "pattern": "(?i)(^|\\W)ні(\\W|$)|не встиг|не змож|не вийде|не можна|неможливо", "ignore_case": false}, {"type": "contains_any", "values": ["понеділ", "вихідн"]}]}}
