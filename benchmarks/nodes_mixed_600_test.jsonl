{"id": "nx-translate-009", "split": "test", "bucket": "translate", "skill": "translate", "label": "translate", "subtype": "Ukrainian → English sentence", "form": "root", "prompt": "Кіт заснув на підвіконні під теплим сонцем. Переклади англійською.", "does": "", "gold": "The cat fell asleep on the windowsill in the warm sun.", "wrong": "The dog is running.", "check": {"type": "all", "rubrics": [{"type": "contains_any", "values": ["cat"]}, {"type": "contains_any", "values": ["asleep", "sleep", "slept"]}, {"type": "contains_any", "values": ["window"]}, {"type": "contains_any", "values": ["sun"]}]}}
{"id": "nx-translate-010", "split": "test", "bucket": "translate", "skill": "translate", "label": "translate", "subtype": "Ukrainian → English sentence", "form": "root", "prompt": "Як перекласти англійською: Листоноша приносить газети щопонеділка.", "does": "", "gold": "The postman brings the newspapers every Monday.", "wrong": "The newspaper is old.", "check": {"type": "all", "rubrics": [{"type": "contains_any", "values": ["postman", "mail carrier", "postwoman", "mailman", "letter carrier"]}, {"type": "contains_any", "values": ["newspaper"]}, {"type": "contains_any", "values": ["monday"]}]}}
{"id": "nx-translate-011", "split": "test", "bucket": "translate", "skill": "translate", "label": "translate", "subtype": "Ukrainian → English sentence", "form": "root", "prompt": "Скажи англійською: Через ремонт вулицю закрили для машин до кінця тижня.", "does": "", "gold": "Because of repairs, the street is closed to cars until the end of the week.", "wrong": "The street is busy.", "check": {"type": "all", "rubrics": [{"type": "contains_any", "values": ["repair", "renovat", "roadwork", "road work", "construction"]}, {"type": "contains_any", "values": ["street"]}, {"type": "contains_any", "values": ["car", "traffic", "vehicle"]}, {"type": "contains_any", "values": ["week"]}]}}
{"id": "nx-translate-012", "split": "test", "bucket": "translate", "skill": "translate", "label": "translate", "subtype": "Ukrainian → English sentence", "form": "root", "prompt": "Моя подруга вчиться грати на скрипці вже три роки. Англійською мовою, будь ласка.", "does": "", "gold": "My friend has been learning to play the violin for three years.", "wrong": "My friend sings.", "check": {"type": "all", "rubrics": [{"type": "contains_any", "values": ["friend"]}, {"type": "contains_any", "values": ["violin"]}, {"type": "contains_any", "values": ["three", "3"]}, {"type": "contains_any", "values": ["year"]}]}}
{"id": "nx-translate-013", "split": "test", "bucket": "translate", "skill": "translate", "label": "translate", "subtype": "Ukrainian → English sentence", "form": "root", "prompt": "Напиши англійською: У нашому місті відкрили нову бібліотеку для дітей.", "does": "", "gold": "A new children's library has opened in our town.", "wrong": "Our town is big.", "check": {"type": "all", "rubrics": [{"type": "contains_any", "values": ["town", "city"]}, {"type": "contains_any", "values": ["new"]}, {"type": "contains_any", "values": ["library"]}, {"type": "contains_any", "values": ["child", "kid"]}]}}
{"id": "nx-translate-014", "split": "test", "bucket": "translate", "skill": "translate", "label": "translate", "subtype": "Ukrainian → English sentence", "form": "root", "prompt": "Переклади з української на англійську: Ми купили квитки на вечірній концерт у філармонії.", "does": "", "gold": "We bought tickets for the evening concert at the philharmonic.", "wrong": "We went home.", "check": {"type": "all", "rubrics": [{"type": "contains_any", "values": ["ticket"]}, {"type": "contains_any", "values": ["evening"]}, {"type": "contains_any", "values": ["concert"]}, {"type": "contains_any", "values": ["philharmonic", "concert hall"]}]}}
{"id": "nx-translate-015", "split": "test", "bucket": "translate", "skill": "translate", "label": "translate", "subtype": "Ukrainian → English sentence", "form": "root", "prompt": "Дідусь щоранку слухає новини по радіо. Як це сказати англійською?", "does": "", "gold": "Grandpa listens to the news on the radio every morning.", "wrong": "Grandpa reads books.", "check": {"type": "all", "rubrics": [{"type": "contains_any", "values": ["grandpa", "grandfather", "granddad"]}, {"type": "contains_any", "values": ["morning"]}, {"type": "contains_any", "values": ["news"]}, {"type": "contains_any", "values": ["radio"]}]}}
{"id": "nx-translate-016", "split": "test", "bucket": "translate", "skill": "translate", "label": "translate", "subtype": "Ukrainian → English sentence", "form": "root", "prompt": "Англійська версія речення: Щоб не спізнитися на літак, ми вийшли з дому о четвертій ранку.", "does": "", "gold": "So as not to miss the plane, we left home at four in the morning.", "wrong": "We missed the bus.", "check": {"type": "all", "rubrics": [{"type": "contains_any", "values": ["plane", "flight", "airport"]}, {"type": "contains_any", "values": ["four", "4"]}, {"type": "contains_any", "values": ["morning", "a.m", "am"]}, {"type": "contains_any", "values": ["left", "leave"]}]}}
{"id": "nx-translate-017", "split": "test", "bucket": "translate", "skill": "translate", "label": "translate", "subtype": "Ukrainian → English sentence", "form": "root", "prompt": "Як буде англійською: Цей магазин продає лише місцеві овочі й фрукти.", "does": "", "gold": "This shop sells only local vegetables and fruit.", "wrong": "This shop is closed.", "check": {"type": "all", "rubrics": [{"type": "contains_any", "values": ["shop", "store"]}, {"type": "contains_any", "values": ["local"]}, {"type": "contains_any", "values": ["vegetable"]}, {"type": "contains_any", "values": ["fruit"]}]}}
{"id": "nx-translate-018", "split": "test", "bucket": "translate", "skill": "translate", "label": "translate", "subtype": "Ukrainian → English sentence", "form": "root", "prompt": "Українське речення для перекладу англійською: Діти зліпили на подвір'ї великого сніговика.", "does": "", "gold": "The children built a big snowman in the yard.", "wrong": "It is snowing.", "check": {"type": "all", "rubrics": [{"type": "contains_any", "values": ["child", "kid"]}, {"type": "contains_any", "values": ["snowman"]}, {"type": "contains_any", "values": ["yard", "courtyard", "garden"]}, {"type": "contains_any", "values": ["big", "large", "huge"]}]}}
{"id": "nx-translate-019", "split": "test", "bucket": "translate", "skill": "translate", "label": "translate", "subtype": "Ukrainian → English sentence", "form": "root", "prompt": "Прошу англійський переклад: Лікар порадив мені більше гуляти на свіжому повітрі.", "does": "", "gold": "The doctor advised me to walk more in the fresh air.", "wrong": "I visited a doctor.", "check": {"type": "all", "rubrics": [{"type": "contains_any", "values": ["doctor"]}, {"type": "contains_any", "values": ["advis", "recommend", "told", "suggest"]}, {"type": "contains_any", "values": ["walk"]}, {"type": "contains_any", "values": ["fresh air", "outside", "outdoors"]}]}}
{"id": "nx-translate-020", "split": "test", "bucket": "translate", "skill": "translate", "label": "translate", "subtype": "Ukrainian → English sentence", "form": "with previous value", "prompt": "Речення з попереднього кроку потрібне англійською: Студентка повернула знайдений гаманець власникові.", "does": "", "gold": "The student returned the found wallet to its owner.", "wrong": "She found money.", "check": {"type": "all", "rubrics": [{"type": "contains_any", "values": ["student"]}, {"type": "contains_any", "values": ["wallet", "purse"]}, {"type": "contains_any", "values": ["return", "gave back", "handed back"]}, {"type": "contains_any", "values": ["owner"]}]}}
{"id": "nx-translate-021", "split": "test", "bucket": "translate", "skill": "translate", "label": "translate", "subtype": "Ukrainian → English sentence", "form": "with previous value", "prompt": "Оголошення, складене раніше, переклади англійською: Шановні мешканці, у суботу з 10:00 до 13:00 відбудеться прибирання двору.", "does": "", "gold": "Dear residents, the yard will be cleaned on Saturday from 10:00 to 13:00.", "wrong": "Dear residents, thank you.", "check": {"type": "all", "rubrics": [{"type": "contains_any", "values": ["resident"]}, {"type": "contains_any", "values": ["saturday"]}, {"type": "contains_any", "values": ["10"]}, {"type": "contains_any", "values": ["clean"]}]}}
