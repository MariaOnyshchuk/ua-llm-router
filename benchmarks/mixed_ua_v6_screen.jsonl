{"id": "ifeval-1928", "bucket": "instruct", "prompt": "Розгорніть наступне речення у формальну історію: «Мій собака коричневий, а мій кіт чорний». Ваша відповідь повинна містити заголовок, обгорнутий у подвійні кутові дужки, тобто <<заголовок>>, і не повинна містити жодних ком. У вашій відповіді слово «плоть» має з'являтися менше ніж 3 рази.", "reference": "", "notes": "source=ifeval_ukr score_mode=ifeval", "ifeval_instruction_id_list": ["detectable_format:title", "punctuation:no_comma", "keywords:frequency"], "ifeval_kwargs": [{"num_highlights": null, "relation": null, "num_words": null, "num_placeholders": null, "prompt_to_repeat": null, "num_bullets": null, "section_spliter": null, "num_sections": null, "capital_relation": null, "capital_frequency": null, "keywords": null, "num_paragraphs": null, "language": null, "let_relation": null, "letter": null, "let_frequency": null, "end_phrase": null, "forbidden_words": null, "keyword": null, "frequency": null, "num_sentences": null, "postscript_marker": null, "first_word": null, "nth_paragraph": null}, {"num_highlights": null, "relation": null, "num_words": null, "num_placeholders": null, "prompt_to_repeat": null, "num_bullets": null, "section_spliter": null, "num_sections": null, "capital_relation": null, "capital_frequency": null, "keywords": null, "num_paragraphs": null, "language": null, "let_relation": null, "letter": null, "let_frequency": null, "end_phrase": null, "forbidden_words": null, "keyword": null, "frequency": null, "num_sentences": null, "postscript_marker": null, "first_word": null, "nth_paragraph": null}, {"num_highlights": null, "relation": "less than", "num_words": null, "num_placeholders": null, "prompt_to_repeat": null, "num_bullets": null, "section_spliter": null, "num_sections": null, "capital_relation": null, "capital_frequency": null, "keywords": null, "num_paragraphs": null, "language": null, "let_relation": null, "letter": null, "let_frequency": null, "end_phrase": null, "forbidden_words": nu