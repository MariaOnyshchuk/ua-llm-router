ics": [{"type": "has_number", "value": 250, "tolerance": 0.01}, {"type": "contains_any", "values": ["бронюю", "бронюв", "заброн"]}, {"type": "contains_any", "values": ["bike", "bicycle"]}]}}]}, "final_step": "asm"}
{"id": "cg100-c-11", "split": "dev", "bucket": "composite", "family": "chain", "class": "chain", "subclass": "3 nodes", "style_of": "GSM8K (STaD), calendar, writing", "stad_id": "6bac8d6c-c3fe-4d5b-8079-2913685b6257", "source_id": null, "request": "Дитина хоче іграшкову машинку за 12 гривень. У неї вже є 4 гривні, і вона щодня відкладає по 2 гривні з кишенькових. Сьогодні понеділок, гроші почне відкладати завтра. Напиши дитині одне підбадьорливе речення: у який день тижня вона зможе купити машинку.", "prompt": "Дитина хоче іграшкову машинку за 12 гривень. У неї вже є 4 гривні, і вона щодня відкладає по 2 гривні з кишенькових. Сьогодні понеділок, гроші почне відкладати завтра. Напиши дитині одне підбадьорливе речення: у який день тижня вона зможе купити машинку.", "nodes": [{"id": "n1", "skill": "math", "does": "(12 − 4) / 2 = 4 дні", "depends_on": [], "attributes": [], "prompt": "Машинка коштує 12 гривень, є 4 гривні, щодня відкладається по 2 гривні. Скільки днів треба відкладати?\nНаприкінці напиши: Відповідь: <число>.", "gold": "(12 − 4) / 2 = 4 дні. Відповідь: 4", "gold_kind": "exact", "criteria": [], "check": {"type": "numeric", "value": 4.0, "tolerance": 0.01}}, {"id": "n2", "skill": "knowledge", "does": "which weekday comes after that many days", "depends_on": ["n1"], "attributes": [], "prompt": "Сьогодні понеділок. Відкладати почнуть завтра і відкладатимуть стільки днів: {{n1.content}}\nУ який день тижня буде останній із цих днів? Назви день тижня.", "gold": "У п'ятницю.", "gold_kind": "accepted", "criteria": [], "check": {"type": "contains_any", "values": ["п'ятниц", "пʼятниц", "п’ятниц"]}}, {"id": "n3", "skill": "instruct", "does": "one encouraging sentence", "depends_on": ["n2"], "attributes": ["1 sentence"], "prompt": "Напиши дитині одне підбадьорливе речення про те, у який день вона зможе купити іграшкову машинку: {{n2.content}}", "gold": "Ще трохи терпіння, і вже в п'ятницю ти купиш свою машинку!", "gold_kind": "example", "criteria": [], "check": {"type": "all", "rubrics": [{"type": "contains_any", "values": ["п'ятниц", "пʼятниц", "п’ятниц"]}, {"type": "sentence_count", "min": 1, "max": 1}]}}], "value_dependency": {"n1->n2": "n2 counts that many days from tomorrow", "n2->n3": "n3 names the day n2 found"}, "answer_gold": "Ще трохи терпіння, і вже в п'ятницю ти купиш свою машинку!", "check": {"type": "all", "rubrics": [{"type": "contains_any", "values": ["п'ятниц", "пʼятниц", "п’ятниц"]}, {"type": "sentence_count", "min": 1, "max": 1}]}, "n_nodes": 3, "depth": 3, "width": 1, "distinct_skills": 3, "reasoning_steps": 3, "shape_control": false, "assembly": false, "oracle_plan": {"steps": [{"id": "n1", "intent": "chat", "depends_on": [], "prompt": "Машинка коштує 12 гривень, є 4 гривні, щодня відкладається по 2 гривні. Скільки днів треба відкладати?\nНаприкінці напиши: Відповідь: <число>.", "rubric": {"type": "numeric", "value": 4.0, "tolerance": 0.01}}, {"id": "n2", "intent": "knowledge", "depends_on": ["n1"], "prompt": "Сьогодні понеділок. Відкладати почнуть завтра і відкладатимуть стільки днів: {{n1.content}}\nУ який день тижня буде останній із цих днів? Назви день тижня.", "rubric": {"type": "contains_any", "values": ["п'ятниц", "пʼятниц", "п’ятниц"]}}, {"id": "n3", "intent": "instruct", "depends_on": ["n2"], "prompt": "Напиши дитині одне підбадьорливе речення про те, у який день вона зможе купити іграшкову машинку: {{n2.content}}", "rubric": {"type": "all", "rubrics": [{"type": "contains_any", "values": ["п'ятниц", "пʼятниц", "п’ятниц"]}, {"type": "sentence_count", "min": 1, "max": 1}]}}]}, "final_step": "n3"}
{"id": "cg100-c-12", "split": "dev", "bucket": "composite", "family": "chain", "class": "chain", "subclass": "3 nodes", "style_of": "commonsense, code, writing", "stad_id": null, "source_id": null, "request": "Мені потрібна Python-функція season(m), яка за номером місяця (1–12) повертає пору року українською малими літерами. Напиши її, а під кодом одним реченням наведи приклад виклику для вересня і що він поверне.", "prompt": "Мені потрібна Python-функція season(m), яка за номером місяця (1–12) повертає пору року українською малими літерами. Напиши її, а під кодом одним реченням наведи приклад виклику для вересня і що він поверне.", "nodes": [{"id": "n1", "skill": "knowledge", "does": "map months to seasons", "depends_on": [], "attributes": [], "prompt": "Які номери місяців (1–12) належать до зими, весни, літа і осені в Україні? Дай чотири рядки.", "gold": "зима: 12, 1, 2\nвесна: 3, 4, 5\nліто: 6, 7, 8\nосінь: 9, 10, 11", "gold_kind": "accepted", "criteria": [], "check": {"type": "contains_all", "values": ["зима", "весна", "літо", "осінь"]}}, {"id": "n2", "skill": "code", "does": "write the function from the mapping", "depends_on": ["n1"], "attributes": [], "prompt": "Напиши Python-функцію season(m), яка за номером місяця повертає пору року українською малими літерами за цим поділом:\n{{n1.content}}\nПоверни лише блок коду.", "gold": "```python\ndef season(m):\n    if m in (12, 1, 2):\n        return \"зима\"\n    if m in (3, 4, 5):\n        return \"весна\"\n    if m in (6, 7, 8):\n        return \"літо\"\n    return \"осінь\"\n```", "gold_kind": "exact", "criteria": [], "check": {"type": "python_function", "entry_point": "season", "only_code": true, "cases": [{"args": [9], "expected": "осінь"}, {"args": [1], "expected": "зима"}, {"args": [6], "expected": "літо"}, {"args": [4], "expected": "весна"}, {"args": [12], "expected": "зима"}]}}, {"id": "n3", "skill": "instruct", "does": "example call under the code", "depends_on": ["n2"], "attributes": [], "prompt": "Ось функція:\n{{n2.content}}\nПовтори код без змін, а під ним одним реченням наведи приклад виклику для вересня і що він поверне.", "gold": "```python\ndef season(m):\n    if m in (12, 1, 2):\n        return \"зима\"\n    if m in (3, 4, 5):\n        return \"весна\"\n    if m in (6, 7, 8):\n        return \"літо\"\n    return \"осінь\"\n```\nНаприклад, season(9) поверне \"осінь\".", "gold_kind": "example", "criteria": [], "check": {"type": "all", "rubrics": [{"type": "python_function", "entry_point": "season", "only_code": false, "cases": [{"args": [9], "expected": "осінь"}, {"args": [1], "expected": "зима"}]}, {"type": "contains_any", "values": ["season(9)"]}, {"type": "contains_any", "values": ["осінь"]}]}}], "value_dependency": {"n1->n2": "the function follows the mapping n1 gave", "n2->n3": "n3 calls the function n2 wrote"}, "answer_gold": "```python\ndef season(m):\n    if m in (12, 1, 2):\n        return \"зима\"\n    if m in (3, 4, 5):\n        return \"весна\"\n    if m in (6, 7, 8):\n        return \"літо\"\n    return \"осінь\"\n```\nНаприклад, season(9) поверне \"осінь\".", "check": {"type": "all", "rubrics": [{"type": "python_function", "entry_point": "season", "only_code": false, "cases": [{"args": [9], "expected": "осінь"}, {"args": [1], "expected": "зима"}]}, {"type": "contains_any", "values": ["season(9)"]}, {"type": "contains_any", "values": ["осінь"]}]}, "n_nodes": 3, "depth": 3, "width": 1, "distinct_skills": 3, "reasoning_steps": 0, "shape_control": false, "assembly": false, "oracle_plan": {"steps": [{"id": "n1", "intent": "knowledge", "depends_on": [], "prompt": "Які номери місяців (1–12) належать до зими, весни, літа і осені в Україні? Дай чотири рядки.", "rubric": {"type": "contains_all", "values": ["зима", "весна", "літо", "осінь"]}}, {"id": "n2", "intent": "code", "depends_on": ["n1"], "prompt": "Напиши Python-функцію season(m), яка за номером місяця повертає пору року українською малими літерами за цим поділом:\n{{n1.content}}\nПоверни лише блок коду.", "rubric": {"type": "python_function", "entry_point": "season", "only_code": true, "cases": [{"args": [9], "expected": "осінь"}, {"args": [1], "expected": "зима"}, {"args": [6], "expected": "літо"}, {"args": [4], "expected": "весна"}, {"args": [12], "expected": "зима"}]}}, {"id": "n3", "intent": "instruct", "depends_on": ["n2"], "prompt": "Ось функція:\n{{n2.content}}\nПовтори код без змін, а під ним одним реченням наведи приклад виклику для вересня і що він поверне.", "rubric": {"type": "all", "rubrics": [{"type": "python_function", "entry_point": "season", "only_code": false, "cases": [{"args": [9], "expected": "осінь"}, {"args": [1], "expected": "зима"}]}, {"type": "contains_any", "values": ["season(9)"]}, {"type": "contains_any", "values": ["осінь"]}]}}]}, "final_step": "n3"}
